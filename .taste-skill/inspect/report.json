 "findings": [
  {
   "level": "WARN",
   "id": "palette-cream",
   "width": 1440,
   "message": "Yellow-cream background (button #e8e4dd, text #e8e4dd).",
   "fix": "Use the drawn palette. If you want warmth, take a low-chroma stone or bone, not a yellow cream.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "few-pictures",
   "width": 1440,
   "message": "Only 0 picture(s) on the page (0 photographs, footage or raster images, 0 interface fragments). Drawings in SVG do not count.",
   "fix": "Find real pictures of the subject's world with scripts/assets.mjs (photographs, archival images, maps, engravings, footage), download them to assets/ and give them room: a hero picture, one per section that has a subject, a full-width band. At least four, usually six to twelve."
  },
  {
   "level": "WARN",
   "id": "no-footage",
   "width": 1440,
   "message": "No video anywhere on the page.",
   "fix": "Look for one honest clip with scripts/assets.mjs --video (the place, the material, the process) and use it as a muted loop with a poster frame. Defend its absence only if no clip fits the subject."
  },
  {
   "level": "FAIL",
   "id": "focal-point",
   "width": 1440,
   "message": "The first screen has no dominant element: the largest type is 56px (3.9vw) and no single picture holds a third of the viewport.",
   "fix": "Make one thing lead: the headline at display size, or one large picture. A grid of many small pictures is not one thing; in blind tests jurors marked a first screen without a headline down every time. On the strongest studied sites the largest type has a median of 8.4vw."
  },
  {
   "level": "WARN",
   "id": "font-not-dealt",
   "width": 1440,
   "message": "The sheet dealt Erode and Erode, but the page renders Switzer, Arial.",
   "fix": "Load the dealt face (the link on the sheet) and put it first in font-family. A build that falls back to a default face lands on the default look."
  },
  {
   "level": "WARN",
   "id": "hero-void",
   "width": 1440,
   "message": "29% of the first screen is one empty block (480×780px at 960,120).",
   "fix": "Place the void on purpose or fill it: move the picture, the film or one fact into it, grow the headline to meet it, or shrink the screen to its content. A void reads as placed only when something closes it on the far side and it is the screen's one rest."
  },
  {
   "level": "FAIL",
   "id": "still-page",
   "width": 1440,
   "message": "Only 1 element(s) moved while the page loaded and scrolled.",
   "fix": "Build the motion layer (SKILL.md step 9, references/motion.md): the signature move, an entrance for the parts of every section, feedback on every control, and one moving picture. Transform and opacity only, with a reduced-motion fallback."
  },
  {
   "level": "FAIL",
   "id": "empty-screens",
   "width": 1440,
   "message": "5 of 5 desktop screens are almost empty ground (under 20% of the screen holds text, a picture or a colour field): screens 1, 2, 3, 4, 5.",
   "fix": "An empty screen is a rest only once per page. Elsewhere it means the section is underbuilt: set its content larger, give it the full information, put it on a colour field, or cut it."
  },
  {
   "level": "FAIL",
   "id": "off-centre",
   "width": 768,
   "message": "The page sits off-centre: its content comes to 63px from the left edge but only to 128px from the right, at 768px.",
   "fix": "Give the page one pair of equal margins. Check the wrapper for a max-width without margin-inline: auto, a grid with an empty last column, or padding on one side only. If one side is meant to hold air, it must still be closed by something that reaches the margin (a picture, the navigation's last item, a figure)."
  }
